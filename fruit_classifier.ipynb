    "\n",
    "# 1. Imports\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from PIL import Image, ImageDraw, ImageFilter\n",
    "import tensorflow as tf\n",
    "from tensorflow.keras import layers, models\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.metrics import classification_report, confusion_matrix\n",
    "\n",
    "np.random.seed(42)\n",
    "tf.random.set_seed(42)\n",
    "\n",
    "IMG_SIZE = 64          # 64x64 images -> keeps training fast\n",
    "CLASSES = [\"apple\", \"banana\", \"orange\"]\n",
    "NUM_CLASSES = len(CLASSES)\n",
    "\n",
    "print(\"TensorFlow version:\", tf.__version__)\n",
    "print(\"Classes:\", CLASSES)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8b12b77d",
   "metadata": {},
   "source": [
    "## 2. Generate a small synthetic fruit dataset\n",
    "\n",
    "Each fruit is drawn as a simple shape with randomized color, size, rotation, position, and a noisy background — enough visual variety for a CNN to learn real patterns quickly."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "c1cccbe3",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-25T01:43:05.631953Z",
     "iopub.status.busy": "2026-07-25T01:43:05.631417Z",
     "iopub.status.idle": "2026-07-25T01:43:06.720939Z",
     "shell.execute_reply": "2026-07-25T01:43:06.719635Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Dataset shape: (900, 64, 64, 3) Labels shape: (900,)\n"
     ]
    }
   ],
   "source": [
    "\n",
    "def random_background(size):\n",
    "    # Random noisy/solid background so the model can't just memorize a blank canvas.\n",
    "    bg_color = tuple(np.random.randint(180, 256, size=3))\n",
    "    img = Image.new(\"RGB\", size, bg_color)\n",
    "    if np.random.rand() < 0.5:\n",
    "        noise = (np.random.rand(size[1], size[0], 3) * 25).astype(np.uint8)\n",
    "        noise_img = Image.fromarray(noise, \"RGB\")\n",
    "        img = Image.blend(img, noise_img, alpha=0.3)\n",
    "    return img\n",
    "\n",
    "\n",
    "def draw_apple(draw, cx, cy, r, color):\n",
    "    draw.ellipse([cx - r, cy - r, cx + r, cy + r * 1.05], fill=color)\n",
    "    # small leaf + stem for a recognizable apple silhouette\n",
    "    draw.line([cx, cy - r, cx, cy - r - r * 0.3], fill=(101, 67, 33), width=max(1, r // 12))\n",
    "    draw.ellipse([cx + 2, cy - r - r * 0.3, cx + r * 0.4, cy - r], fill=(34, 139, 34))\n",
    "\n",
    "\n",
    "def draw_banana(draw, cx, cy, r, color):\n",
    "    # (kept for potential reuse; actual banana rendering is done via a rotated blob below)\n",
    "    pass\n",
    "\n",
    "\n",
    "def draw_orange(draw, cx, cy, r, color):\n",
    "    draw.ellipse([cx - r, cy - r, cx + r, cy + r], fill=color)\n",
    "    draw.ellipse([cx - r * 0.15, cy - r - r * 0.15, cx + r * 0.15, cy - r + r * 0.1],\n",
    "                 fill=(101, 67, 33))\n",
    "\n",
    "\n",
    "def generate_fruit_image(label, size=IMG_SIZE):\n",
    "    img = random_background((size, size))\n",
    "    draw = ImageDraw.Draw(img)\n",
    "    cx = size // 2 + np.random.randint(-6, 7)\n",
    "    cy = size // 2 + np.random.randint(-6, 7)\n",
    "    r = np.random.randint(size // 4, size // 2 - 4)\n",
    "\n",
    "    if label == \"apple\":\n",
    "        color = (np.random.randint(180, 256), np.random.randint(0, 60), np.random.randint(0, 50))\n",
    "        draw_apple(draw, cx, cy, r, color)\n",
    "    elif label == \"banana\":\n",
    "        color = (np.random.randint(220, 256), np.random.randint(200, 240), np.random.randint(0, 60))\n",
    "        # simple curved banana using a rotated ellipse \"blob\"\n",
    "        blob = Image.new(\"RGBA\", (size, size), (0, 0, 0, 0))\n",
    "        bdraw = ImageDraw.Draw(blob)\n",
    "        bdraw.ellipse([cx - r * 1.4, cy - r * 0.5, cx + r * 1.4, cy + r * 0.5], fill=color + (255,))\n",
    "        blob = blob.rotate(np.random.randint(-30, 30), center=(cx, cy))\n",
    "        img.paste(blob, (0, 0), blob)\n",
    "    else:  # orange\n",
    "        color = (np.random.randint(230, 256), np.random.randint(120, 170), np.random.randint(0, 40))\n",
    "        draw_orange(draw, cx, cy, r, color)\n",
    "\n",
    "    img = img.filter(ImageFilter.GaussianBlur(radius=0.5))\n",
    "    return np.array(img, dtype=np.uint8)\n",
    "\n",
    "\n",
    "def build_dataset(n_per_class=300):\n",
    "    X, y = [], []\n",
    "    for idx, label in enumerate(CLASSES):\n",
    "        for _ in range(n_per_class):\n",
    "            X.append(generate_fruit_image(label))\n",
    "            y.append(idx)\n",
    "    X = np.array(X, dtype=np.float32) / 255.0\n",
    "    y = np.array(y, dtype=np.int64)\n",
    "    return X, y\n",
    "\n",
    "X, y = build_dataset(n_per_class=300)   # 900 images total -> fast to train, plenty to learn from\n",
    "print(\"Dataset shape:\", X.shape, \"Labels shape:\", y.shape)\n"
   ]
  },
