   "source": [
    "## 9. Predict on new (unseen) images"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "9fdfbc7e",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-25T01:43:41.897038Z",
     "iopub.status.busy": "2026-07-25T01:43:41.896788Z",
     "iopub.status.idle": "2026-07-25T01:43:42.321741Z",
     "shell.execute_reply": "2026-07-25T01:43:42.320626Z"
    }
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1800x300 with 6 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "\n",
    "def predict_and_show(n=6):\n",
    "    X_new, y_new = build_dataset(n_per_class=max(1, n // NUM_CLASSES))\n",
    "    idxs = np.random.choice(len(X_new), size=n, replace=False)\n",
    "\n",
    "    preds = model.predict(X_new[idxs], verbose=0)\n",
    "    pred_labels = np.argmax(preds, axis=1)\n",
    "\n",
    "    fig, axes = plt.subplots(1, n, figsize=(3 * n, 3))\n",
    "    for ax, i, pl in zip(axes, idxs, pred_labels):\n",
    "        ax.imshow(X_new[i])\n",
    "        true_label = CLASSES[y_new[i]]\n",
    "        pred_label = CLASSES[pl]\n",
    "        confidence = preds[list(idxs).index(i)][pl]\n",
    "        color = \"green\" if true_label == pred_label else \"red\"\n",
    "        ax.set_title(f\"pred: {pred_label}\\n({confidence:.0%})\\ntrue: {true_label}\", color=color, fontsize=10)\n",
    "        ax.axis(\"off\")\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "predict_and_show(6)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1d2ff4ad",
   "metadata": {},
   "source": [
    "\n",
    "## 10. (Optional) Use a real image folder instead\n",
    "\n",
    "If you have real fruit photos organized like:\n",
    "\n",
    "```\n",
